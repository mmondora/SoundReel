# ============================================
# SoundReel — Environment Variables (self-hosted)
# ============================================
# Copy to .env and fill. chmod 600 .env.
# ============================================

# --- Postgres ---
DB_PASSWORD=change-me-please

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://soundreel.casamon.dev/spotify/callback

# --- TMDb ---
TMDB_API_KEY=

# --- Ollama (via gpu-router per load balancing archi-PC + geekom) ---
OLLAMA_URL=http://gpu-router:9000
OLLAMA_TEXT_MODEL=glm-4.7-flash:q4_K_M
OLLAMA_VISION_MODEL=moondream:latest

# --- Instaloader ---
# If you want authenticated Instagram fetches, set a username and run:
#   docker exec -it soundreel-instaloader instaloader -l <username>
# once to seed the session cookie (stored in the volume).
INSTALOADER_USERNAME=

# --- Local media pipeline ---
# Whisper ASR + OCR sidecar URLs (internal docker network)
WHISPER_URL=http://soundreel-whisper:9000
# GPU-router TTS pool (OpenAI-compat). Host smoke: http://127.0.0.1:9001/tts
TTS_URL=http://gpu-router:9000/tts
OCR_URL=http://soundreel-ocr:5001
# Model size: tiny|base|small|medium|large-v3
WHISPER_MODEL=small
# Shared media volume mount path (inside backend container)
MEDIA_ROOT=/data/media
# Vision key frames per video (1-10)
KEY_FRAMES_COUNT=5

# --- SoundReel read API ---
API_SECRET=

# --- Frontend public URL ---
FRONTEND_URL=https://soundreel.casamon.dev

# --- Spooty (download MP3 da link Spotify via Telegram) ---
SPOOTY_URL=http://spooty:3000
SPOOTY_FRONTEND_URL=https://spooty.casamon.dev

# --- Playwright fallback (JS-rendered pages: Twitter, LinkedIn, etc.) ---
# Chromium installato via apt nel container (bookworm). Disabilitare con false se problemi.
CHROMIUM_PATH=/usr/bin/chromium
PLAYWRIGHT_ENABLED=true

# --- MP3 archive (songs fetched from YouTube + replica on the home media server) ---
# All optional: the defaults below are what docker-compose.yml / the code already use.
# Folder (inside MUSIC_LIBRARY_PATH, mounted read-write) that receives downloaded songs.
# MUSIC_STORE_DIR=SoundReel
# Download worker: off switch and parallel downloads.
# SONG_DOWNLOADER_ENABLED=1
# SONG_DOWNLOAD_CONCURRENCY=2
# Media server (FRITZ!Box DLNA): catalogue + direct URLs of the replica written by scripts/fritz-sync.sh.
# MEDIA_SERVER_ENABLED=1
# MEDIA_SERVER_CONTROL_URL=http://192.168.178.10:49000/MediaServer/ContentDirectory/Control
# MEDIA_SERVER_FILE_BASE=http://192.168.178.10:49200/AUDIO/DLNA-1-0
# MEDIA_REPLICA_ROOT=Music/SoundReel
# instaloader sidecar only: YouTube cookies (age-restricted / "not a bot" songs), mounted at this path.
# YTDLP_COOKIES=/root/.config/yt-dlp/cookies.txt

# Library search (ADR-0011). Roots that the web configuration may pick extra music folders from, comma separated
# container paths (mount the host folders read-only in docker-compose.yml). /music is always searched.
# MUSIC_EXTRA_ROOTS=/music-extra
# How the library root is shown in search results.
# MUSIC_LIBRARY_LABEL=~/Music
# Song enrichment (genres, covers) from Deezer/iTunes; 0 switches it off.
# SONG_ENRICHMENT_ENABLED=1
