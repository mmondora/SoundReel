# Copy to ~/.config/soundreel/fritz-sync.env — no root needed, and no secrets
# live here: the CIFS password sits in the credentials file referenced by the
# /etc/fstab line (see fritz-sync.fstab.example), where mount.cifs reads it
# directly.
#
# The mountpoint must match the one in that fstab entry exactly, or `mount`
# with a bare path has nothing to resolve.
MOUNTPOINT=/home/mike/.local/share/soundreel/fritz

# Volume directory inside the share, asserted before any rsync runs. This is
# the guard against a swapped or unplugged stick: without it, an --delete
# sync could act on the wrong tree.
FRITZ_VOLUME=TESLA_MEDIA

MUSIC_SRC=/home/mike/Music
FILMS_SRC=/home/mike/Films
