<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export straight to App Store Connect (TestFlight): "upload" instead of writing an .ipa. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>5NZADC9YQ2</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The build number is decided by scripts/testflight.sh (it must grow for every upload of the same version):
	     do not let Xcode change it behind our back. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
