<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>it.mikesoft.mondrop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mondrop</string>
			</array>
		</dict>
	</array>
	<!-- Only standard HTTPS: exempt encryption. Without this key App Store Connect asks the export-compliance question
	     for every build and holds it back from testers until someone answers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- HTTP only to local-network hosts (the home media server); everything else stays HTTPS. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mondrop scarica i brani direttamente dal media server di casa, sulla tua rete locale.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
