<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>it.mikesoft.mondrop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mondrop</string>
			</array>
		</dict>
	</array>
	<!-- Only standard HTTPS: exempt encryption. Without this key App Store Connect asks the export-compliance question
	     for every build and holds it back from testers until someone answers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The app is written in Italian and says so: Siri understands the sentences of the App Shortcuts («Ehi Siri, mi piace questa canzone su
	     Mondrop») only in the languages the app supports (spec 2026-11-10-mondrop-like-and-repeat-design.md L9). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>it</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Everything is HTTPS and goes to SoundReel only (rule P, ADR-0018): no exception for the local network any more.
		     The app has no direct path to the media server. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- At home SoundReel's name resolves to an address of the local network (split-horizon DNS), and iOS then asks for the
	     «Rete locale» permission: this is what the question says. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Quando sei a casa, Mondrop parla con il server SoundReel direttamente sulla tua rete locale.</string>
	<!-- The whole app is dark, whatever the phone's appearance is: the yellow of Mondrop does not read on white (spec 2026-11-08-mondrop-home-spotify-design.md H9). -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
